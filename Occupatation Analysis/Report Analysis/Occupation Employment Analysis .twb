      <aliases enabled='yes' />
      <column caption='Baby boomer' datatype='real' name='[Baby_boomer]' role='measure' type='quantitative' />
      <column caption='Baby boomer per Year' datatype='integer' name='[Baby_boomer_per_Year]' role='measure' type='quantitative' />
      <column caption='Occupation Level' datatype='string' name='[Calculation_1033013210457849861]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [jobs_2013_5d] &gt;= 300000 THEN &quot;High-employment occupations&quot;&#13;&#10;ELSEIF  [jobs_2013_5d] &gt;=100000 THEN &quot;Mid-employment occupations&quot; &#13;&#10;ELSEIF  [jobs_2013_5d] &gt;20000 THEN &quot;Low-employment occupations&quot;&#13;&#10;ELSEIF  [jobs_2013_5d] &lt;=20000 THEN &quot;Very_Low-employment occupations&quot;&#13;&#10;END' />
